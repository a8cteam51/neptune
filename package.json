{
	"name": "neptune",
	"version": "0.0.0",
	"license": "MIT",
	"bin": {
		"neptune": "dist/cli.js"
	},
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"test": "tsc && ava",
		"postinstall": "playwright install chromium"
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.2.126",
		"ink": "^5.2.1",
		"ink-select-input": "^6.2.0",
		"ink-spinner": "^5.0.0",
		"ink-text-input": "^6.0.0",
		"meow": "^14.1.0",
		"odiff-bin": "^4.3.8",
		"playwright": "^1.59.1",
		"pngjs": "^7.0.0",
		"react": "^18.3.1",
		"tar": "^7.5.13"
	},
	"devDependencies": {
		"@sindresorhus/tsconfig": "^7.0.0",
		"@types/pngjs": "^6.0.5",
		"@types/react": "^18.3.12",
		"@vdemedes/prettier-config": "^2.0.1",
		"ava": "^6.4.1",
		"eslint-config-xo-react": "^0.27.0",
		"eslint-plugin-react": "^7.32.2",
		"eslint-plugin-react-hooks": "^4.6.0",
		"ink-testing-library": "^4.0.0",
		"prettier": "^3.4.2",
		"tsx": "^4.21.0",
		"typescript": "^5.7.2",
		"xo": "^0.60.0"
	},
	"ava": {
		"files": [
			"test/**/*.test.ts",
			"test/**/*.test.tsx",
			"!test/helpers/**",
			"!test/fixtures/**"
		],
		"extensions": {
			"ts": "module",
			"tsx": "module"
		},
		"nodeArguments": [
			"--import=tsx/esm"
		],
		"workerThreads": false
	},
	"xo": {
		"extends": "xo-react",
		"prettier": true,
		"rules": {
			"react/prop-types": "off"
		}
	},
	"prettier": "@vdemedes/prettier-config"
}
