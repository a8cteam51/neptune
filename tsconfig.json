{
	"extends": "@sindresorhus/tsconfig",
	"compilerOptions": {
		"outDir": "dist",
		"module": "Node16",
		"moduleResolution": "Node16",
		"target": "ES2022",
		"jsx": "react",
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": false,
		"esModuleInterop": true,
		"skipLibCheck": true
	},
	"include": ["source"]
}
